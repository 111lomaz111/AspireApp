# Container image name for apiservice
APISERVICE_IMAGE=ghcr.io/111lomaz111/aspireapp-apiservice:latest

# Parameter apiservice-port
APISERVICE_PORT=8081

# Parameter cache-password
CACHE_PASSWORD=change_this_password

# Container image name for webfrontend
WEBFRONTEND_IMAGE=ghcr.io/111lomaz111/aspireapp-web:latest

# Parameter webfrontend-port
WEBFRONTEND_PORT=8080